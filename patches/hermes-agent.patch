--- /dev/null
+++ b/gateway/stream_delivery_receipt.py
@@ -0,0 +1,61 @@
+"""Content-free final receipts for the existing native text-delivery event bus.
+
+Intermediate send/edit/draft observations remain at the adapter. The runner calls
+this only after exact full-content delivery or a positively acknowledged final
+reconciliation edit. Missing acknowledgements never become answer proof.
+"""
+from __future__ import annotations
+
+import hashlib
+import logging
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def observe_confirmed_stream_final(consumer, source, response, *, confirmed_text=None) -> bool:
+    if consumer is None or not isinstance(response, dict) or response.get("already_sent") is not True:
+        return False
+    if response.get("failed") or response.get("interrupted") or response.get("completed") is False:
+        return False
+    final = response.get("final_response")
+    if not isinstance(final, str) or not final.strip() or final == "(empty)":
+        return False
+    if confirmed_text is None:
+        if getattr(consumer, "_delivery_ambiguous", False):
+            return False
+        matcher = getattr(consumer, "delivered_final_matches", None)
+        if not callable(matcher):
+            return False
+        try:
+            if matcher(final) is not True:
+                return False
+        except Exception:
+            return False
+    elif confirmed_text != final:
+        return False
+    try:
+        fingerprint = hashlib.sha256(final.encode()).digest()
+    except UnicodeError:
+        return False
+    if getattr(consumer, "_stream_final_receipt_fingerprint", None) == fingerprint:
+        return False
+    metadata = getattr(consumer, "metadata", None) or {}
+    platform = getattr(source, "platform", None)
+    try:
+        from hermes_cli.plugins import _delivery_manager
+        scheduled = _delivery_manager()._dispatch_event("hermes:gateway_text_delivery", {
+            "platform": getattr(platform, "value", str(platform or "")),
+            "chat_id": str(source.chat_id),
+            "thread_id": metadata.get("message_thread_id") or metadata.get("thread_id") or getattr(source, "thread_id", None),
+            "reply_to": getattr(consumer, "_initial_reply_to_id", None),
+            "success": True, "visible": True, "kind": "stream_final",
+            "at_monotonic": time.monotonic(), "interim": False, "answer": True,
+            "job_final": metadata.get("_ole_dialogue_job_final") is True,
+        })
+        if scheduled:
+            consumer._stream_final_receipt_fingerprint = fingerprint
+        return bool(scheduled)
+    except Exception:
+        logger.debug("stream final delivery observation failed", exc_info=True)
+        return False
