+        if len(matches)!=1:return None
+        key,value=matches[0];records.pop(key,None);return value[0]
+
+class TurnOrigin:
+    def __init__(self,sid,record,agent,envelope,*,request=None,receipt=None,binding=None):
+        self.sid=sid;self.record=record;self.agent=agent;self.actor=agent;self.envelope=envelope
