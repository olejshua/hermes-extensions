diff --git a/gateway/plugin_continuation.py b/gateway/plugin_continuation.py
new file mode 100644
index 0000000..fb12768
--- /dev/null
+++ b/gateway/plugin_continuation.py
@@ -0,0 +1,110 @@
+"""Optional registered continuation on the existing Main claim; no scheduler.
+
+Only process-private native objects carry provenance. Public MessageEvent
+metadata, plugin text and ordinary internal events cannot supply this grant.
+Durable idempotency belongs to the registered workflow handler, not a second
+generic gateway job engine. A scheduling True is never an acceptance receipt.
+"""
+from dataclasses import dataclass
+import hashlib
+import json
+import re
+import weakref
+
+
+@dataclass(frozen=True)
+class Request:
+    manager_ref: object
+    handler: object
+    plugin_id: str
+    continuation_id: str
+    session_key: str
+    expected_session_id: str
+    descriptor: dict
+    descriptor_hash: str
+
+    def current(self):
+        manager=self.manager_ref()
+        return manager is not None and manager._gateway_continuations.get(self.plugin_id) is self.handler
+
+
+def request(manager, plugin_id, continuation_id, expected_session_id):
+    if not re.fullmatch('[a-f0-9]{64}',continuation_id or '') or not isinstance(expected_session_id,str) or not expected_session_id:
+        raise ValueError('invalid_continuation_identity')
+    handler=manager._gateway_continuations.get(plugin_id)
+    if handler is None:raise ValueError('registered_continuation_required')
+    value=handler.descriptor(continuation_id)
+    required={'continuation_id','session_key','session_id','owner','message_id','source_hash','version','prompt'}
+    if (not isinstance(value,dict) or set(value)!=required or value['continuation_id']!=continuation_id or
+        value['session_id']!=expected_session_id or not isinstance(value['prompt'],str) or len(value['prompt'])>2000 or
+        not re.fullmatch('[a-f0-9]{64}',value['source_hash'] or '') or type(value['version']) is not int or value['version']<1 or
+        any(not isinstance(value[k],str) or not value[k] or len(value[k])>256 for k in ('session_key','session_id','owner','message_id'))):
+        raise ValueError('continuation_descriptor_required')
+    encoded=json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False)
+    return Request(weakref.ref(manager),handler,plugin_id,continuation_id,value['session_key'],expected_session_id,
+                   dict(value),hashlib.sha256(encoded.encode()).hexdigest())
+
+
+def source_matches(req, source):
+    return (type(req) is Request and req.current() and
+        getattr(getattr(source,'platform',None),'value',None)=='telegram' and
+        getattr(source,'chat_type',None) in ('dm','private') and
+        'telegram:'+str(getattr(source,'user_id',''))==req.descriptor['owner'] and
+        str(getattr(source,'chat_id',''))==str(getattr(source,'user_id','')) and
+        getattr(source,'profile',None) in (None,'') and not getattr(source,'is_bot',False) and
+        not getattr(source,'profile_route_rejected',False))
+
+
+class Grant:
+    def __init__(self,req,gateway,event,generation,receipt):
+        self.request=req;self.gateway_ref=weakref.ref(gateway);self.event=event;self.generation=generation
+        self.receipt=receipt;self.actor=None
+    def owns_turn(self):
+        gateway=self.gateway_ref();req=self.request
+        if gateway is None or not req.current():return False
+        if not gateway._is_session_run_current(req.session_key,self.generation):return False
+        state=gateway._peek_session_state(req.session_key)
+        return state is not None and state.turn.event is self.event
+    def live(self):
+        return self.owns_turn() and self.request.handler.validate(self.request,self.receipt)
+    def bind_provider(self,agent,session_id):
+        if (not self.live() or session_id!=self.request.expected_session_id or not agent or
+            getattr(agent,'session_id',None)!=session_id or getattr(agent,'is_subagent',False)):
+            return False
+        gateway=self.gateway_ref()
+        if gateway._peek_session_state(self.request.session_key).turn.agent is not agent:return False
+        if self.actor is not None and self.actor is not agent:return False
+        self.actor=agent
+        return True
+
+
+async def admit(event,gateway,session_key,generation):
+    req=getattr(event,'_hermes_registered_continuation',None)
+    # Missing private object is normal legacy traffic. Forged public metadata
+    # creates no grant and does not alter the general Internal admission policy.
+    if req is None:return True
+    if type(req) is not Request or not req.current() or req.session_key!=session_key:return False
+    if not getattr(event,'internal',False) or getattr(event,'allow_gateway_control',True):return False
+    entry=await gateway.async_session_store.lookup_by_session_key(session_key)
+    if (entry is None or entry.session_id!=req.expected_session_id or
+        not source_matches(req,event.source) or gateway._session_key_for_source(event.source)!=session_key or
+        not gateway._is_user_authorized_for_source(event.source,allow_adapter_delegation=False) or
+        not gateway._is_session_run_current(session_key,generation)):
+        req.handler.block(req.continuation_id,'native_session_or_owner_changed')
+        return False
+    state=gateway._peek_session_state(session_key)
+    if state is None or state.turn.event is not event:return False
+    # No await between the last native generation/session checks and the
+    # registered handler's BEGIN IMMEDIATE once-accept commit.
+    try:receipt=req.handler.accept(req,session_key,entry.session_id,generation)
+    except Exception:
+        # A local once receipt may already have committed. Preserve it and
+        # expose uncertainty rather than leaving a never-started Main as active.
+        try:req.handler.block(req.continuation_id,'native_accept_response_unknown_no_main_dispatch')
+        except Exception:pass
+        return False
+    if not isinstance(receipt,dict) or receipt.get('accepted') is not True:return False
+    grant=Grant(req,gateway,event,generation,receipt)
+    event._hermes_continuation_grant=grant
+    req.handler.granted(grant)
+    return True
diff --git a/gateway/plugin_message_hooks.py b/gateway/plugin_message_hooks.py
new file mode 100644
index 0000000..7e11273
--- /dev/null
+++ b/gateway/plugin_message_hooks.py
@@ -0,0 +1,86 @@
+"""Bounded native message policy and content-free delivery observations.
+
+Policy only runs at admitted fire-sites. Observations use the existing off-path,
+profile-scoped plugin event bus and never carry message content.
+"""
+from __future__ import annotations
+import asyncio
+from functools import wraps
+import inspect
+import time
+
+async def dispatch(name, *, budget_seconds=0.25, **payload):
+    from hermes_cli.plugins import _delivery_manager
+    manager = _delivery_manager()
+    results=[]
+    deadline=time.monotonic()+budget_seconds
+    # Existing bounded sync dispatcher tracks/suppresses abandoned callbacks.
+    for callback in manager.iter_hook_callbacks(name):
+        remaining=deadline-time.monotonic()
+        if remaining<=0:
+            break
+        try:
+            narrowed=manager._hook_callback_kwargs(callback,payload)
+            if inspect.iscoroutinefunction(callback):
+                result=await asyncio.wait_for(callback(**narrowed),remaining)
+            else:
+                result=await asyncio.wait_for(asyncio.to_thread(manager._run_hook_callback_bounded,name,callback,payload,remaining),remaining)
+            if result is not None:
+                results.append(result)
+        except (Exception,SystemExit):
+            continue  # Native fallthrough, never consume a user's turn on an extension failure.
+    return results
+
+async def admitted(event, gateway, session_key, *, busy=False):
+    if getattr(event,'internal',False):
+        return None
+    results=await dispatch('gateway_message_admitted',budget_seconds=0.5,event=event,gateway=gateway,session_key=session_key,busy=busy,turn_task=asyncio.current_task())
+    for result in results:
+        if not isinstance(result,dict) or result.get('action') != 'reply':
+            continue
+        text=result.get('text')
+        if isinstance(text,str) and text.strip() and len(text) <= 2000:
+            return text
+    return None
+
+async def finish_turn(event, adapter, session_key):
+    """Bounded notification from native cleanup, preserving the actual turn generation."""
+    turn_task=asyncio.current_task()
+    completion=asyncio.create_task(dispatch('gateway_turn_finished',event=event,adapter=adapter,
+        session_key=session_key,turn_task=turn_task))
+    # A second cancellation must not cancel the already bounded release notification.
+    # Native cleanup and task guard ownership remain the adapter's responsibility.
+    try:
+        await asyncio.shield(completion)
+    except asyncio.CancelledError:
+        completion.add_done_callback(lambda task: task.exception() if not task.cancelled() else None)
+        raise
+
+def observe_text_delivery(kind):
+    """Declared at adapter methods, not a runtime replacement or monkeypatch."""
+    def decorate(method):
+        @wraps(method)
+        async def wrapped(self,chat_id,*args,**kwargs):
+            result=await method(self,chat_id,*args,**kwargs)
+            try:
+                from hermes_cli.plugins import _delivery_manager
+                bound=inspect.signature(method).bind(self,chat_id,*args,**kwargs)
+                metadata=bound.arguments.get('metadata') or {}
+                content=bound.arguments.get('content')
+                visible=(getattr(result,'success',False) is True and isinstance(content,str) and bool(content.strip())
+                         and not (isinstance(getattr(result,'raw_response',None),dict) and result.raw_response.get('skipped')))
+                _delivery_manager()._dispatch_event('hermes:gateway_text_delivery',{
+                    'platform':self.platform.value,'chat_id':str(chat_id),
+                    'thread_id':metadata.get('message_thread_id') or metadata.get('thread_id'),
+                    'reply_to':bound.arguments.get('reply_to'),
+                    'success':getattr(result,'success',False) is True,'visible':visible,
+                    'kind':kind,'at_monotonic':time.monotonic(),
+                    'interim':metadata.get('_interim_send') is True,
+                    'answer':metadata.get('_gateway_text_role') == 'answer' and metadata.get('_interim_send') is not True,
+                    'job_final':metadata.get('_ole_dialogue_job_final') is True,
+                })
+            except Exception:
+                pass
+            return result
+        return wrapped
+    return decorate
