+        return None
+    call=tool_calls[0]
+    tail=messages[-1]
+    if tail.get('role') != 'tool' or tail.get('tool_call_id') != call.id:
+        return None
+    from hermes_cli.plugins import _delivery_manager
+    manager=_delivery_manager()
+    name=call.function.name
+    if name == 'tool_call':
+        import json
+        from tools.tool_search import resolve_underlying_call
+        try:
+            underlying, _, error = resolve_underlying_call(json.loads(call.function.arguments))
+            if error or underlying != tail.get('name'):
+                return None
+            name=underlying
