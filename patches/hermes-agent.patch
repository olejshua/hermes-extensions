+    def owns_turn(self):
+        from tui_gateway import server
+        r=self.record
+        return (CURRENT.get() is self and server._current_runtime_session_record.get() is r and
+            server._sessions.get(self.sid) is r and r.get('running') and not r.get('_closing') and
+            r.get('agent') is self.agent and str(getattr(self.agent,'session_id',''))==self.session_id and
+            str(r.get('session_key') or '')==self.session_key and r.get('active_session_lease') is self.lease and
+            self.lease is not None and not getattr(self.lease,'released',False) and
+            int(r.get('_queued_prompt_generation',0))==self.generation and
+            server._session_transport_contains(r,self.envelope.transport))
+    def bound(self,binding):
+        from tui_gateway import server
+        if not self.owns_turn() or home_of(self.record)!=binding.profile_home or not login_matches(self.envelope.login,binding):return False
+        # Sharing with a foreign/missing authenticated owner is ambiguous for
+        # this narrow Call capability; ordinary shared chat is unchanged.
+        return all(login_matches(getattr(t,'_hermes_native_login',None),binding)
