+++ b/tests/gateway/test_auto_session_rotation.py
@@ -0,0 +1,167 @@
+"""Opt-in automatic gateway session rotation: shadow metrics, idle boundary and recovery."""
+
+from __future__ import annotations
+
+import threading
+
+from gateway.config import GatewayConfig, Platform
+from gateway.session import SessionSource, SessionStore
+
+
+def _source() -> SessionSource:
+    return SessionSource(
+        platform=Platform.TELEGRAM, chat_id="rotation-test", chat_type="dm", user_id="user-1",
+    )
+
+
+def test_shadow_observations_do_not_rotate_without_opt_in(tmp_path, monkeypatch):
+    monkeypatch.delenv("HERMES_SESSION_AUTO_ROTATE", raising=False)
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    assert store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="in_place") == 1
+    assert store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.90, compaction_outcome="ineffective") == 2
+
+    assert store.get_or_create_session(_source()).session_id == entry.session_id
+    assert store.lookup_by_session_key(entry.session_key).session_id == entry.session_id
+    store._db.close()
+
+
+def test_opted_in_rotation_publishes_handoff_before_cas_repoint(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    old_id = entry.session_id
+    store._db.append_message(session_id=old_id, role="user", content="important prior work")
+    store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="in_place")
+    store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="ineffective")
+
+    rotated = store.get_or_create_session(_source())
+
+    assert rotated.session_id != old_id
+    assert store._db.get_session(old_id)["end_reason"] == "compression"
+    assert store._db.get_session(rotated.session_id)["parent_session_id"] == old_id
+    handoff = store._db.get_messages_as_conversation(rotated.session_id)
+    assert len(handoff) == 1
+    assert old_id in handoff[0]["content"]
+    assert "important prior work" in handoff[0]["content"]
+    store._db.close()
+
+
+def test_active_turn_blocks_rotation_even_when_enabled(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "true")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="in_place")
+    store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="in_place")
+    token = store.mark_turn_active(entry.session_key)
+
+    assert store.get_or_create_session(_source()).session_id == entry.session_id
+    assert store.clear_turn_active(entry.session_key, token)
+    store._db.close()
+
+
+def test_configured_real_prompt_cost_can_shadow_qualify_below_context_threshold(tmp_path, monkeypatch):
+    monkeypatch.delenv("HERMES_SESSION_AUTO_ROTATE", raising=False)
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE_MIN_PROMPT_COST_USD", "0.90")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+
+    assert store.observe_auto_rotation_pressure(
+        entry.session_key, context_ratio=.50, compaction_outcome="in_place", prompt_cost_usd=.986,
+    ) == 1
+    observation = store.lookup_by_session_key(entry.session_key).metadata["auto_rotate_pressure_observations"]
+    assert observation["qualified_by"] == "prompt_cost"
+    assert store.get_or_create_session(_source()).session_id == entry.session_id
+    store._db.close()
+
+
+def test_failed_handoff_leaves_route_unchanged(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "on")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="in_place")
+    store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.85, compaction_outcome="in_place")
+    monkeypatch.setattr(store._db, "publish_compression_child", lambda **kwargs: (_ for _ in ()).throw(RuntimeError("disk full")))
+
+    assert store.get_or_create_session(_source()).session_id == entry.session_id
+    store._db.close()
+
+
+def test_turn_starting_after_first_idle_snapshot_prevents_publication(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    for _ in range(2):
+        store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.86, compaction_outcome="in_place")
+    original_switch = store.switch_session
+    started = []
+
+    def _start_turn_before_cas(*args, **kwargs):
+        started.append(store.mark_turn_active(entry.session_key))
+        return original_switch(*args, **kwargs)
+
+    monkeypatch.setattr(store, "switch_session", _start_turn_before_cas)
+    assert store.get_or_create_session(_source()).session_id == entry.session_id
+    db = getattr(store, "_db")
+    assert db.get_session(entry.session_id)["ended_at"] is None
+    assert store.clear_turn_active(entry.session_key, started[0])
+    db.close()
+
+
+def test_turn_attempt_during_publication_waits_for_child_route(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    for _ in range(2):
+        store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.86, compaction_outcome="in_place")
+    db = getattr(store, "_db")
+    publish = db.publish_compression_child
+    threads, tokens = [], []
+
+    def _publish_with_incoming_turn(**kwargs):
+        thread = threading.Thread(target=lambda: tokens.append(store.mark_turn_active(entry.session_key)))
+        threads.append(thread)
+        thread.start()
+        publish(**kwargs)
+
+    monkeypatch.setattr(db, "publish_compression_child", _publish_with_incoming_turn)
+    child = store.get_or_create_session(_source())
+    for thread in threads:
+        thread.join(timeout=2)
+        assert not thread.is_alive()
+    assert child.session_id != entry.session_id
+    assert len(tokens) == 1 and tokens[0]
+    current = store.lookup_by_session_key(entry.session_key)
+    assert current is not None and current.session_id == child.session_id
+    assert current.active_turn_token == tokens[0]
+    assert store.clear_turn_active(entry.session_key, tokens[0])
+    db.close()
+
+
+def test_route_write_failure_after_handoff_rolls_back_in_memory_and_recovers(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    store = SessionStore(sessions_dir=tmp_path, config=GatewayConfig())
+    entry = store.get_or_create_session(_source())
+    old_id = entry.session_id
+    for _ in range(2):
+        store.observe_auto_rotation_pressure(entry.session_key, context_ratio=.86, compaction_outcome="in_place")
+    original_save = store._save
+    failures = []
+
+    def _fail_once():
+        if not failures:
+            failures.append(True)
+            raise OSError("route mirror full")
+        return original_save()
+
+    monkeypatch.setattr(store, "_save", _fail_once)
+    assert store._maybe_auto_rotate_pressure_session(entry.session_key) is None
+    assert store.lookup_by_session_key(entry.session_key).session_id == old_id
+    db = store._db
+    assert db.get_session(old_id)["end_reason"] == "compression"
+    # A child was durably published before the route mirror failed. Ordinary
+    # compression-tip healing makes that branch the next addressed session.
+    recovered = store.get_or_create_session(_source())
+    assert recovered.session_id != old_id
+    assert db.get_session(recovered.session_id)["parent_session_id"] == old_id
+    db.close()
