diff --git a/plugins/platforms/telegram/update_journal.py b/plugins/platforms/telegram/update_journal.py
new file mode 100644
index 0000000..7a6609d
--- /dev/null
+++ b/plugins/platforms/telegram/update_journal.py
@@ -0,0 +1,401 @@
+"""Durable backing for PTB's one native update queue, before transport ACK.
+
+This is an ingress journal, not an executor. Native Application handlers, gateway
+session/turn ownership and delivery obligations retain their existing lifecycles.
+Uncertain callback/command effects remain inspectable and are never raw-replayed.
+"""
+from __future__ import annotations
+
+import asyncio
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import threading
+import time
+import uuid
+
+from telegram import Update
+
+
+class IngressConflict(RuntimeError):
+    """Identity/payload or live-owner conflict; do not acknowledge this input."""
+
+
+def input_owner(event):
+    """The existing native run_turn._hmwa_prepare_turn namespace, unchanged."""
+    source = event.source
+    namespace = [source.platform.value, source.profile, source.scope_id,
+                 source.chat_id, source.thread_id, str(event.message_id)]
+    return str(uuid.uuid5(uuid.NAMESPACE_URL, json.dumps(namespace)))
+
+
+def event_ids(event):
+    return tuple(getattr(event, '_telegram_durable_update_ids', ()))
+
+
+def link_events(target, incoming):
+    if target is not None:
+        target._telegram_durable_update_ids = tuple(dict.fromkeys(
+            (*event_ids(target), *event_ids(incoming))))
+
+
+class UpdateJournal:
+    def __init__(self, home: Path, credential: str):
+        from hermes_cli.process_identity import _process_create_time
+        self.home = Path(home).resolve()
+        self.credential_hash = hashlib.sha256(credential.encode()).hexdigest()
+        directory = self.home / 'telegram_ingress'
+        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+        self.path = directory / (self.credential_hash + '.sqlite')
+        fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
+        os.close(fd)
+        self.pid = os.getpid()
+        self.birth = _process_create_time(self.pid)
+        if self.birth is None:
+            raise IngressConflict('durable ingress requires a native process identity')
+        self.nonce = uuid.uuid4().hex
+        self.lock = threading.RLock()
+        self.recovered_ids = set()
+        self.bot_id = None
+        self.dispatched_ids = set()
+        self.dispatch_count = 0
+        self.db = sqlite3.connect(self.path, isolation_level=None, check_same_thread=False)
+        self.db.row_factory = sqlite3.Row
+        self.db.execute('PRAGMA journal_mode=WAL')
+        self.db.execute('PRAGMA synchronous=FULL')
+        self.db.executescript('''
+            CREATE TABLE IF NOT EXISTS ingress_owner (
+                singleton INTEGER PRIMARY KEY CHECK(singleton=1), home TEXT NOT NULL,
+                credential_hash TEXT NOT NULL, bot_id INTEGER, pid INTEGER NOT NULL,
+                birth REAL NOT NULL, nonce TEXT NOT NULL);
+            CREATE TABLE IF NOT EXISTS ingress_updates (
+                update_id INTEGER PRIMARY KEY, payload TEXT NOT NULL, digest TEXT NOT NULL,
+                chat_id TEXT, user_id TEXT, state TEXT NOT NULL DEFAULT 'received',
+                received REAL NOT NULL, event_seen INTEGER NOT NULL DEFAULT 0,
+                session_key TEXT, session_id TEXT, input_owner TEXT,
+                disposition TEXT, updated REAL NOT NULL);
+        ''')
+        with self.lock:
+            self.db.execute('BEGIN IMMEDIATE')
+            try:
+                old = self.db.execute('SELECT * FROM ingress_owner').fetchone()
+                if old:
+                    if old['home'] != str(self.home) or old['credential_hash'] != self.credential_hash:
+                        raise IngressConflict('durable ingress profile/credential binding differs')
+                    if old['nonce']:
+                        from gateway.lifecycle_ledger import _pid_is_sentinel_owner
+                        if _pid_is_sentinel_owner(old['pid'], None, old['birth']):
+                            raise IngressConflict('durable ingress already has a live native owner')
+                    self.bot_id = old['bot_id']
+                    self.db.execute('UPDATE ingress_owner SET pid=?,birth=?,nonce=? WHERE singleton=1',
+                                    (self.pid, self.birth, self.nonce))
+                else:
+                    self.db.execute('INSERT INTO ingress_owner VALUES (1,?,?,?,?,?,?)',
+                                    (str(self.home), self.credential_hash, None,
+                                     self.pid, self.birth, self.nonce))
+                self.db.execute('COMMIT')
+                self.cold_ids = {row[0] for row in self.db.execute(
+                    "SELECT update_id FROM ingress_updates WHERE state NOT IN ('terminal','native','uncertain')")}
+                self.recovered_ids.update(self.cold_ids)
+            except BaseException:
+                self.db.execute('ROLLBACK')
+                self.db.close()
+                raise
+
+    @contextmanager
+    def transaction(self):
+        with self.lock:
+            self.db.execute('BEGIN IMMEDIATE')
+            try:
+                owner = self.db.execute('SELECT nonce FROM ingress_owner').fetchone()
+                if not owner or owner['nonce'] != self.nonce:
+                    raise IngressConflict('durable ingress owner was fenced')
+                yield self.db
+                self.db.execute('COMMIT')
+            except BaseException:
+                self.db.execute('ROLLBACK')
+                raise
+
+    def bind_bot(self, bot_id):
+        if type(bot_id) is not int or bot_id <= 0:
+            raise IngressConflict('invalid Telegram bot identity')
+        with self.transaction() as db:
+            prior = db.execute('SELECT bot_id FROM ingress_owner').fetchone()['bot_id']
+            if prior is not None and prior != bot_id:
+                raise IngressConflict('Telegram bot differs from durable ingress owner')
+            db.execute('UPDATE ingress_owner SET bot_id=?', (bot_id,))
+        self.bot_id = bot_id
+
+    def receive(self, update):
+        if self.bot_id is None or type(update.update_id) is not int:
+            raise IngressConflict('unbound Telegram update')
+        try:
+            receiving_bot = update.get_bot()
+        except RuntimeError as exc:
+            raise IngressConflict('Telegram update has no receiving bot') from exc
+        if receiving_bot.id != self.bot_id:
+            raise IngressConflict('Telegram update belongs to another receiving bot')
+        payload = json.dumps(json.loads(update.to_json()), sort_keys=True,
+                             ensure_ascii=False, separators=(',', ':'))
+        digest = hashlib.sha256(payload.encode()).hexdigest()
+        chat = getattr(update.effective_chat, 'id', None)
+        user = getattr(update.effective_user, 'id', None)
+        with self.transaction() as db:
+            prior = db.execute('SELECT digest,state FROM ingress_updates WHERE update_id=?',
+                               (update.update_id,)).fetchone()
+            if prior:
+                if prior['digest'] != digest:
+                    raise IngressConflict('same Telegram update ID has different original bytes')
+                return prior['state'] == 'received'
+            now = time.time()
+            db.execute('INSERT INTO ingress_updates '
+                       '(update_id,payload,digest,chat_id,user_id,received,updated) VALUES (?,?,?,?,?,?,?)',
+                       (update.update_id, payload, digest, str(chat) if chat is not None else None,
+                        str(user) if user is not None else None, now, now))
+        return True
+
+    def begin_dispatch(self, update_id):
+        with self.transaction() as db:
+            accepted = db.execute("UPDATE ingress_updates SET state='dispatching',event_seen=0,updated=? "
+                                  "WHERE update_id=? AND state='received'",
+                                  (time.time(), update_id)).rowcount == 1
+            if accepted:
+                self.dispatch_count += 1
+                if update_id in self.cold_ids:
+                    self.dispatched_ids.add(update_id)
+            return accepted
+
+    def bind_event(self, event, update_id):
+        event._telegram_durable_update_ids = (update_id,)
+        with self.transaction() as db:
+            db.execute('UPDATE ingress_updates SET event_seen=1,updated=? WHERE update_id=?',
+                       (time.time(), update_id))
+
+    def disposition(self, ids, state, reason):
+        if not ids:
+            return
+        with self.transaction() as db:
+            db.executemany('UPDATE ingress_updates SET state=?,disposition=?,updated=? WHERE update_id=?',
+                           [(state, reason, time.time(), uid) for uid in ids])
+
+    def callback_finished(self, update_id, *, succeeded):
+        with self.transaction() as db:
+            row = db.execute('SELECT state,event_seen FROM ingress_updates WHERE update_id=?',
+                             (update_id,)).fetchone()
+            if row and not row['event_seen'] and succeeded:
+                db.execute("UPDATE ingress_updates SET state='terminal',disposition='handler_no_event',"
+                           'updated=? WHERE update_id=?', (time.time(), update_id))
+
+    def bind_native(self, event, session_key, session_id):
+        ids = event_ids(event)
+        if not ids:
+            return
+        with self.transaction() as db:
+            db.executemany('UPDATE ingress_updates SET session_key=?,session_id=?,input_owner=?,updated=? '
+                           'WHERE update_id=?', [(session_key, session_id, input_owner(event),
+                                                  time.time(), uid) for uid in ids])
+
+    def native_binding(self, event):
+        ids = event_ids(event)
+        if not ids:
+            return None
+        uid = getattr(event, 'platform_update_id', None)
+        if uid not in ids:
+            uid = ids[0]
+        with self.lock:
+            row = self.db.execute('SELECT session_id,input_owner FROM ingress_updates WHERE update_id=?',
+                                  (uid,)).fetchone()
+            return dict(row) if row is not None else None
+
+    def attention_count(self):
+        with self.lock:
+            return self.db.execute("SELECT COUNT(*) FROM ingress_updates WHERE state='uncertain'").fetchone()[0]
+
+    def rows(self):
+        with self.lock:
+            return [dict(row) for row in self.db.execute('SELECT * FROM ingress_updates ORDER BY update_id')]
+
+    async def replayable(self, adapter):
+        runner = getattr(adapter, 'gateway_runner', None)
+        result = []
+        for row in self.rows():
+            if row['update_id'] not in self.cold_ids or row['update_id'] in self.dispatched_ids:
+                continue
+            if row['state'] in {'terminal', 'native', 'uncertain'}:
+                continue
+            if row['session_id'] and runner is not None:
+                owned = await runner.async_session_store.has_input_owner(
+                    row['session_id'], row['input_owner'])
+                if owned:
+                    self.disposition((row['update_id'],), 'native', 'native_transcript_owner')
+                    continue
+                # The native turn marker was published before its original reached the
+                # transcript. Replay that original instead of an empty synthetic resume.
+                entry = await runner.async_session_store.lookup_by_session_key(row['session_key'])
+                if entry is not None and entry.session_id == row['session_id']:
+                    await runner.async_session_store.clear_resume_pending(row['session_key'])
+            self.disposition((row['update_id'],), 'received', 'cold_replay')
+            self.recovered_ids.add(row['update_id'])
+            result.append(Update.de_json(json.loads(row['payload']), adapter._bot))
+        return result
+
+    def close(self):
+        with self.transaction() as db:
+            db.execute("UPDATE ingress_owner SET nonce='' WHERE singleton=1")
+        self.db.close()
+
+
+class DurableUpdateQueue(asyncio.Queue):
+    """PTB's existing queue; every transport put commits before it can advance ACK."""
+    def __init__(self, adapter):
+        super().__init__()
+        self.adapter = adapter
+        self.journal = UpdateJournal(adapter._update_receipt_dir, adapter.config.token)
+        self.enqueued_ids = set()
+        self.startup_tail_complete = asyncio.Event()
+        self._startup_barrier_changed = asyncio.Event()
+        self._input_fault = False
+        self._startup_tail_ids = None
+        self._committed_ids = set()
+
+    def reset_startup_barrier(self):
+        self.adapter._durable_resume_ready = False
+        self.startup_tail_complete.clear()
+        self._startup_barrier_changed.clear()
+        self._input_fault = False
+        self._startup_tail_ids = None
+        self._committed_ids.clear()
+
+    def observe_poll_batch(self, updates):
+        # Same native poller, no competing getUpdates. A full 100-row batch
+        # may have an offline tail; wait for its first shorter batch as well.
+        if self.startup_tail_complete.is_set() or not isinstance(updates, list):
+            return
+        if len(updates) < 100:
+            self._startup_tail_ids = {u['update_id'] for u in updates}
+            self._check_startup_tail()
+
+    def _check_startup_tail(self):
+        if (self._startup_tail_ids is not None
+                and self._startup_tail_ids <= self._committed_ids):
+            self.startup_tail_complete.set()
+            self._startup_barrier_changed.set()
+            self._committed_ids.clear()
+            self._startup_tail_ids = None
+            schedule = getattr(self.adapter, '_schedule_durable_recovery', None)
+            if callable(schedule):
+                schedule()
+
+    async def wait_startup_tail(self):
+        await asyncio.wait_for(self._startup_barrier_changed.wait(), timeout=60.0)
+        if self._input_fault or not self.startup_tail_complete.is_set():
+            raise IngressConflict('Telegram ingress persistence/poll prefix is not ready')
+
+    def _put_committed(self, item, admitted):
+        if not isinstance(item, Update):
+            return super().put_nowait(item)  # Native Application shutdown sentinel.
+        self._input_fault = False
+        if not self.startup_tail_complete.is_set():
+            self._committed_ids.add(item.update_id)
+            self._check_startup_tail()
+        if admitted and item.update_id not in self.enqueued_ids:
+            self.enqueued_ids.add(item.update_id)
+            super().put_nowait(item)
+
+    async def put(self, item):
+        try:
+            admitted = (await asyncio.to_thread(self.journal.receive, item)
+                        if isinstance(item, Update) else True)
+        except Exception as exc:
+            self.reset_startup_barrier()
+            self._input_fault = True
+            self._startup_barrier_changed.set()
+            if isinstance(exc, IngressConflict):
+                raise
+            # PTB's existing retry/stop lifecycle owns transient ingress faults.
+            # An uncaught non-Telegram exception leaves its stop Event latched.
+            from telegram.error import NetworkError
+            raise NetworkError('Telegram ingress journal commit failed; pending updates retained') from exc
+        self._put_committed(item, admitted)
+
+    def put_nowait(self, item):
+        try:
+            admitted = self.journal.receive(item) if isinstance(item, Update) else True
+        except Exception as exc:
+            self.reset_startup_barrier()
+            self._input_fault = True
+            self._startup_barrier_changed.set()
+            if isinstance(exc, IngressConflict):
+                raise
+            # PTB's existing retry/stop lifecycle owns transient ingress faults.
+            # An uncaught non-Telegram exception leaves its stop Event latched.
+            from telegram.error import NetworkError
+            raise NetworkError('Telegram ingress journal commit failed; pending updates retained') from exc
+        self._put_committed(item, admitted)
+
+    def get_nowait(self):
+        item = super().get_nowait()
+        if isinstance(item, Update):
+            self.enqueued_ids.discard(item.update_id)
+        return item
+
+
+async def bind_native_turn(runner, event, session_key):
+    adapter = runner._intake_adapter_for(event.source)
+    queue = getattr(adapter, '_durable_update_queue', None)
+    if queue is not None and event_ids(event):
+        entry = await runner.async_session_store.lookup_by_session_key(session_key)
+        if entry is None:
+            raise IngressConflict('native ingress has no session owner')
+        queue.journal.bind_native(event, session_key, entry.session_id)
+
+
+def fence_command(runner, event):
+    if event.get_command() is None:
+        return
+    adapter = runner._intake_adapter_for(event.source)
+    queue = getattr(adapter, '_durable_update_queue', None)
+    if queue is not None:
+        queue.journal.disposition(event_ids(event), 'uncertain', 'command_entered')
+
+
+def native_hook_entered(runner, event):
+    adapter = runner._intake_adapter_for(event.source)
+    queue = getattr(adapter, '_durable_update_queue', None)
+    if queue is not None and event_ids(event):
+        queue.journal.disposition(event_ids(event), 'uncertain', 'native_admission_hook_entered')
+        event._telegram_durable_hook_uncertain = True
+
+
+def native_hook_returned(runner, event, reply):
+    if reply is not None:
+        return  # No durable hook-effect handoff was supplied; never raw-retry it.
+    adapter = runner._intake_adapter_for(event.source)
+    queue = getattr(adapter, '_durable_update_queue', None)
+    if queue is not None and event_ids(event):
+        queue.journal.disposition(event_ids(event),
+            'uncertain' if event.get_command() is not None else 'dispatching',
+            'command_entered' if event.get_command() is not None else 'native_hook_not_handled')
+        event._telegram_durable_hook_uncertain = False
+
+
+async def finish_native_input(adapter, event, outcome):
+    from gateway.platforms.event import ProcessingOutcome
+    queue = getattr(adapter, '_durable_update_queue', None)
+    if queue is None or outcome != ProcessingOutcome.SUCCESS:
+        return
+    if any(getattr(event, flag, False) for flag in ('_telegram_restore_queued',
+            '_telegram_durable_deferred', '_telegram_durable_hook_uncertain')):
+        return
+    runner = getattr(adapter, 'gateway_runner', None)
+    if runner is not None and getattr(event, '_heartbeat_execution_started', False):
+        binding = queue.journal.native_binding(event)
+        if (not binding or not binding['session_id'] or not binding['input_owner']
+                or not await runner.async_session_store.has_input_owner(
+                    binding['session_id'], binding['input_owner'])):
+            queue.journal.disposition(event_ids(event), 'uncertain', 'native_original_handoff_unproven')
+            return
+    queue.journal.disposition(event_ids(event), 'terminal', 'native_processing_complete')
