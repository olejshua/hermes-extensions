+    def descriptor(self,binding):
+        if not self.bound(binding):raise ValueError('native_desktop_owner_not_bound')
+        return dict(owner='desktop:'+binding.fingerprint,session_key=self.session_key,session_id=self.session_id,message_id=self.message_id)
+    def live(self):
+        return self.owns_turn() and (self.request is None or (self.request.current() and self.request.handler.validate(self.request,self.receipt)))
+    def bind_provider(self,agent,session_id):return agent is self.agent and session_id==self.session_id and self.live()
+
+def current(actor,session_id,binding):
+    frame=CURRENT.get()
+    return frame if (type(frame) is TurnOrigin and frame.agent is actor and frame.session_id==session_id and
+        not getattr(actor,'is_subagent',False) and frame.bound(binding) and frame.live()) else None
+
+def prepare_turn(sid,session,agent,user=None,request=None):
+    from tui_gateway import server
+    if request is None:
+        if (type(user) is not UserEnvelope or user.epoch!=EPOCH or user.sid!=sid or user.record is not session or
+            user.session_key!=session.get('session_key') or not server._session_transport_contains(session,user.transport)):
+            return None
+        return TurnOrigin(sid,session,agent,user)
+    from gateway.plugin_continuation import Request
+    if type(request) is not Request or not request.current():raise ValueError('registered_desktop_continuation_required')
+    binding=request.handler.desktop_binding()
+    if request.descriptor['owner']!='desktop:'+binding.fingerprint:raise ValueError('native_desktop_owner_not_bound')
+    if (request.session_key!=session.get('session_key') or request.expected_session_id!=str(getattr(agent,'session_id','')) or
+        home_of(session)!=binding.profile_home or session.get('_turn_cancel_requested')):
+        raise ValueError('native_desktop_session_changed')
