new file mode 100644
index 0000000..5c16761
--- /dev/null
+++ b/tools/child_slot_limiter.py
@@ -0,0 +1,69 @@
+"""Additive native child slots; delegate-waiting parents release their active slot."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+import functools
+import fcntl
+import os
+from pathlib import Path
+import threading
+import time
+_ACTIVE=ContextVar('native_active_child_slot',default=None)
+
+class _Lease:
+    def __init__(self,root,child):
+        self.root,self.child=root,child;self.fd=None;self.suspended=0;self.closed=False;self.lock=threading.RLock()
+    def acquire(self):
+        while self.fd is None and not self.closed and not self.suspended:
+            if self.child is not None and getattr(self.child,'_interrupt_requested',False):raise InterruptedError('child_slot_cancelled')
+            for index in range(2):
+                candidate=os.open(self.root/('slot-'+str(index)+'.lock'),os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
+                try:fcntl.flock(candidate,fcntl.LOCK_EX|fcntl.LOCK_NB)
+                except BlockingIOError:os.close(candidate);continue
+                self.fd=candidate;break
+            if self.fd is None:time.sleep(.1)
+    def close(self):
+        with self.lock:
+            self.closed=True
+            if self.fd is not None:os.close(self.fd);self.fd=None
+    @contextmanager
+    def suspended_for_delegate(self):
+        with self.lock:
+            self.suspended+=1
+            if self.fd is not None:os.close(self.fd);self.fd=None
+        try:yield
+        finally:
+            with self.lock:
+                self.suspended-=1
+                if not self.suspended and not self.closed:self.acquire()
+
+@contextmanager
+def child_slot(child=None):
+    value=os.environ.get('HERMES_CHILD_SLOT_ROOT')
+    if not value:
+        yield;return
+    root=Path(value)
+    if not root.is_absolute():raise ValueError('absolute_child_slot_root_required')
+    for p in (root,*root.parents):
+        if p.is_symlink():raise ValueError('symlink_child_slot_root')
+    root.mkdir(parents=True,mode=0o700,exist_ok=True)
+    if root.stat().st_uid!=os.getuid() or root.stat().st_mode&0o077:raise ValueError('private_child_slot_root_required')
+    lease=_Lease(root,child);lease.acquire();token=_ACTIVE.set(lease)
+    try:yield
+    finally:lease.close();_ACTIVE.reset(token)
+
+def run_child_conversation(child,**kwargs):
+    # The actual child thread retains the slot when a parent abandons its Future.
+    with child_slot(child):return child.run_conversation(**kwargs)
+
+def suspend_slot_while_delegating(callback):
+    """Native delegate dispatch boundary: waiting ancestors aren't active children.
+
+    ContextVars are inherited by native tool executor threads. Each child starts
+    a fresh lease; concurrent delegate tools share their parent's suspend count.
+    """
+    @functools.wraps(callback)
+    def run(*args,**kwargs):
+        lease=_ACTIVE.get()
+        if lease is None:return callback(*args,**kwargs)
+        with lease.suspended_for_delegate():return callback(*args,**kwargs)
+    return run
