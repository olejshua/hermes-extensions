new file mode 100644
index 0000000..04068f9
--- /dev/null
+++ b/agent/aux_provider_policy.py
@@ -0,0 +1,18 @@
+"""Additive context-local provider policy; consumer pins existing subscription route."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+_ALLOWED=ContextVar('aux_allowed_providers',default=None)
+class ProviderPolicyError(RuntimeError):pass
+@contextmanager
+def allowed_auxiliary_providers(providers):
+    chosen=frozenset(providers)
+    if not chosen:raise ValueError('empty auxiliary provider policy')
+    prior=_ALLOWED.get()
+    if prior is not None:chosen=chosen & prior
+    token=_ALLOWED.set(chosen)
+    try:yield
+    finally:_ALLOWED.reset(token)
+def enforce_auxiliary_provider(provider):
+    allowed=_ALLOWED.get()
+    if allowed is not None and provider not in allowed:
+        raise ProviderPolicyError('auxiliary provider forbidden by caller policy')
