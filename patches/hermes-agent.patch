+"""Operator-granted native Desktop controls; no arbitrary RPC text/target authority."""
+from dataclasses import dataclass
+import asyncio
+import uuid
+import time
+
+
+@dataclass(frozen=True)
+class ControlReply:
+    frame: object
+    text: str
+
+
+def register(ctx, handler):
+    if ctx.get_config('desktop_dialogue_enabled', False) is not True:
+        raise PermissionError('explicit_desktop_dialogue_grant_required')
+    if not all(callable(getattr(handler, k, None)) for k in ('admitted_native', 'finished_native', 'accepted_job', 'delivery_binding')):
+        raise TypeError('native_desktop_dialogue_handler_required')
+    manager = ctx._manager
+    if not hasattr(manager, '_desktop_dialogues'):
+        manager._desktop_dialogues = {}
+    if manager._desktop_dialogues:
+        raise ValueError('single_desktop_dialogue_required')
+    entry = {'plugin_id': ctx.plugin_id, 'handler': handler}
+    return ctx._track_mapping_entry('desktop_dialogue', ctx.plugin_id, manager._desktop_dialogues, entry)
+
+
+def _registered():
+    from hermes_cli.plugins import _delivery_manager
+    manager = _delivery_manager()
+    entries = list(getattr(manager, '_desktop_dialogues', {}).values())
+    if len(entries) != 1:
+        return None, None
+    entry = entries[0]
+    plugin = manager._plugins.get(entry['plugin_id'])
+    if plugin is None or not plugin.enabled or plugin.module is None:
+        return None, None
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.plugins_state import _plugin_settings_entry
+    settings = (_plugin_settings_entry(load_config_readonly() or {}, entry['plugin_id']) or {}).get('settings') or {}
+    if settings.get('desktop_dialogue_enabled') is not True:
+        return None, None
+    return manager, entry
+
+
+class _Lane:
+    def finished_native(self, frame):
+        from tui_gateway import server
+        with server._sessions_lock:
+            if frame.record.get('_hermes_desktop_dialogue_frame') is frame:
+                frame.record.pop('_hermes_desktop_dialogue_frame', None)
+
+
+def claimed(frame):
+    from tui_gateway.plugin_continuation import TurnOrigin
+    from tui_gateway import server
+    if type(frame) is not TurnOrigin:
+        return
+    # Runs at actual native claim, regardless of an optional callback succeeding.
+    with server._sessions_lock:
+        frame.record['_hermes_desktop_dialogue_frame'] = frame
+        frame.handlers.append(_Lane())
+
+
+def start_failed(frame):
+    if frame is not None:
+        _Lane().finished_native(frame)
+
+
+def admitted(frame, text):
+    from tui_gateway.plugin_continuation import TurnOrigin
+    if type(frame) is not TurnOrigin or frame.request is not None or not frame.owns_turn():
+        return None
+    manager, entry = _registered()
+    if entry is None:
+        return None
+    try:
+        deadline = time.monotonic() + 0.5
+        response = manager._run_hook_callback_bounded('desktop_dialogue_admitted', entry['handler'].admitted_native,
+                                                    {'frame': frame, 'text': text, 'deadline': deadline,
+                                                     'session_id':frame.session_id,'turn_id':frame.message_id}, 0.5)
+        if (isinstance(response, str) and 0 < len(response) <= 2000 and frame.owns_turn()
+                and time.monotonic() < deadline):
+            return ControlReply(frame, response)
+    except (Exception, SystemExit):
+        pass
+    return None  # The real native turn continues on unknown/error/timeout.
+
+
+def submitted(identity, row):
+    _, entry = _registered()
+    if entry is None:
+        return False
+    return entry['handler'].accepted_job(identity, row) is True
+
+
+def controlled(identity,action,job):
+    _,entry=_registered()
