+"""Private native WS/User/Main provenance and registered continuations.
+
+No auth values, free RPC role flags, scheduler, message transport or provider.
+Owner attribution is an independently reviewed private Root binding; a WS
+login, None-user, source label or session id cannot attribute an owner alone.
+"""
+import contextvars
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path
+import uuid
+
+EPOCH=uuid.uuid4().hex
+CURRENT=contextvars.ContextVar('hermes_native_main_origin',default=None)
+def digest(value):return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+@dataclass(frozen=True)
+class Login:
+    epoch: str
+    kind: str
+    uid: int
+    root_home: str
+    principal: str | None
+
+def authenticated_login(kind,*,identity=None):
+    # Called only AFTER existing successful native WS authentication. No
+    # token/nonce/header/body is passed here, persisted or exported.
+    from hermes_constants import get_hermes_home
+    if kind not in ('desktop-ssh-session','dashboard-ticket'):raise ValueError('native_login_kind_required')
+    principal=None
+    if kind=='dashboard-ticket':
+        if not isinstance(identity,dict) or not all(isinstance(identity.get(k),str) and identity[k] for k in ('provider','user_id')):
+            raise ValueError('native_authenticated_identity_required')
+        principal=digest({k:identity[k] for k in ('provider','user_id')})
+    return Login(EPOCH,kind,os.getuid(),str(Path(get_hermes_home()).resolve()),principal)
+
+@dataclass(frozen=True)
+class OwnerBinding:
+    fingerprint: str
+    owner: str
+    profile_home: str
+    uid: int
+    login_kind: str
+    principal: str | None
+
+def read_owner_binding(path,expected_sha256,*,owner,profile_home):
+    p=Path(path)
+    if (not p.is_absolute() or p.is_symlink() or p.stat().st_uid!=os.getuid() or p.stat().st_mode&0o077):
+        raise ValueError('private_root_origin_binding_required')
+    raw=p.read_bytes()
+    if hashlib.sha256(raw).hexdigest()!=expected_sha256:raise ValueError('root_origin_binding_drift')
+    value=json.loads(raw)
+    if (set(value)!={'contract','owner','profile_home','runtime_uid','login_kind','auth_principal_sha256'} or
+        value['contract']!='hermes-main-origin-root-binding-v1' or value['owner']!=owner or
+        value['profile_home']!=str(Path(profile_home).resolve()) or type(value['runtime_uid']) is not int or
+        value['runtime_uid']!=os.getuid() or value['login_kind'] not in ('desktop-ssh-session','dashboard-ticket') or
+        (value['login_kind']=='desktop-ssh-session' and value['auth_principal_sha256'] is not None) or
+        (value['login_kind']=='dashboard-ticket' and (not isinstance(value['auth_principal_sha256'],str) or len(value['auth_principal_sha256'])!=64))):
+        raise ValueError('root_origin_binding_scope_mismatch')
+    return OwnerBinding(expected_sha256,owner,value['profile_home'],value['runtime_uid'],value['login_kind'],value['auth_principal_sha256'])
+
+def login_matches(login,binding):
+    return (type(login) is Login and login.epoch==EPOCH and type(binding) is OwnerBinding and
+        (login.kind,login.uid,login.root_home,login.principal)==
+        (binding.login_kind,binding.uid,binding.profile_home,binding.principal))
+
+def home_of(session):
+    from hermes_constants import get_hermes_home
+    return str(Path(session.get('profile_home') or get_hermes_home()).resolve())
+
+@dataclass(frozen=True)
+class UserEnvelope:
+    epoch: str
+    sid: str
+    record: object
+    transport: object
+    login: object
+    session_key: str
+    message_id: str
+
+def user_envelope(sid,session,transport):
+    from tui_gateway import server
+    login=getattr(transport,'_hermes_native_login',None)
+    with server._sessions_lock:
+        if (server._sessions.get(sid) is not session or type(login) is not Login or login.epoch!=EPOCH or
+            not server._session_transport_contains(session,transport) or session.get('_closing')):return None
+        return UserEnvelope(EPOCH,sid,session,transport,login,str(session.get('session_key') or ''),uuid.uuid4().hex)
+
+def record_queued_user(session,envelope,text):
+    # Record the exact resulting existing native queue envelope. Same-login
+    # user merges remain lossless; an unproved/mixed prior message grants none.
+    if type(envelope) is not UserEnvelope or not isinstance(text,str):return
+    with session['history_lock']:
+        rows=([session['queued_prompt']] if session.get('queued_prompt') else [])+list(session.get('queued_prompts') or [])
+        records=session.setdefault('_hermes_native_queued_origins',{})
+        for key in set(records)-{id(r)for r in rows}:records.pop(key,None)
+        if not rows:return
