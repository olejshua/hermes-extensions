+        return None
+    entry=getattr(manager,'_tool_handoffs',{}).get(name)
+    if entry is None:
+        return None
+    # A foreign tool/plugin cannot forge a terminal flag by returning a matching JSON string.
+    owners=[key for key,p in manager._plugins.items() if p.enabled and name in p.tools_registered]
+    if len(owners) != 1 or owners[0] not in entry['owners']:
+        return None
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.plugins_state import _plugin_settings_entry
+    settings=(_plugin_settings_entry(load_config_readonly() or {},entry['plugin_id']) or {}).get('settings') or {}
+    if name not in settings.get('handoff_tools',[]) or owners[0] not in settings.get('handoff_tool_plugins',[]):
+        return None
+    try:
+        result=manager._run_hook_callback_bounded('post_tool_round_handoff',entry['callback'],
+            {'agent':agent,'tool_calls':[SimpleNamespace(id=call.id,function=SimpleNamespace(name=name))],'messages':messages},0.25)
+        if (type(result) in (TurnHandoff, SessionHandoff, SilentTurnHandoff) and result.tool_name == name and isinstance(result.response,str)
+                and (0 <= len(result.response) <= 1000 if type(result) in (SessionHandoff, SilentTurnHandoff) else 0 < len(result.response) <= 1000)):
+            return result
+    except (Exception,SystemExit):
+        pass
+    return None
