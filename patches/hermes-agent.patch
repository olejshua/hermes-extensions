+"""Server-owned idle Desktop/TUI session rotation RPC."""
+
+from __future__ import annotations
+
+import threading
+
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+def _call(params: dict) -> dict:
+    return server.handle_request({"id": "rotate", "method": "session.rotate", "params": params})
+
+
+def _seed(db: SessionDB, sid: str, *, source: str = "desktop") -> None:
+    db.create_session(sid, source=source, model="test-model")
+    db.append_message(sid, "user", "Need the deployment plan.")
+    db.append_message(sid, "assistant", "Plan: validate, deploy, and verify readback.")
+
+
+def test_rotate_rpc_publishes_bounded_handoff_and_readable_lineage(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    parent = "20260925_aaaaaa"
+    _seed(db, parent)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    try:
+        response = _call({"session_id": parent})
+        assert "result" in response, response
+        child = response["result"]["session_id"]
+        assert response["result"]["parent_session_id"] == parent
+        assert db.get_session(parent)["end_reason"] == "compression"
+        child_row = db.get_session(child)
+        assert child_row["parent_session_id"] == parent
+        handoff = db.get_messages_as_conversation(child)
+        assert len(handoff) == response["result"]["message_count"] == 1
+        assert parent in handoff[0]["content"]
+        assert "deployment plan" in handoff[0]["content"]
+        assert db.get_compression_tip(parent) == child
+        # Cold resume/readback keeps native ancestor lineage plus the child handoff.
+        resumed, _display = db.get_resume_conversations(child)
+        assert any("deployment plan" in str(row.get("content")) for row in resumed)
+    finally:
+        db.close()
+
+
+def test_rotate_rpc_refuses_live_running_approval_queue_and_pinned(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    original_sessions = dict(server._sessions)
+    try:
+        for suffix, state in (("running", {"running": True}),
+                              ("approval", {"pending_approval": {"id": "a"}}),
+                              ("queued", {"queued_prompt": {"text": "later"}})):
+            parent = f"20260925_{suffix[:6]:0<6}"
+            _seed(db, parent)
+            server._sessions.clear()
+            server._sessions["live"] = {
+                "session_key": parent, "profile_home": None, "history_lock": threading.Lock(), **state,
+            }
+            response = _call({"session_id": parent})
+            assert response["error"]["code"] == 4009
+            assert db.get_session(parent)["end_reason"] is None
+
+        pinned = "20260925_pinned"
+        _seed(db, pinned)
+        assert db.set_session_pinned(pinned, True)
+        server._sessions.clear()
+        response = _call({"session_id": pinned})
+        assert response["error"]["code"] == 4009
+        assert db.get_session(pinned)["end_reason"] is None
+    finally:
+        server._sessions.clear()
+        server._sessions.update(original_sessions)
+        db.close()
+
+
+def test_rotate_rpc_never_touches_telegram_or_rolls_forward_on_publish_failure(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    try:
+        telegram = "20260925_telegr"
+        _seed(db, telegram, source="telegram")
+        response = _call({"session_id": telegram})
+        assert response["error"]["code"] == 4009
+        assert db.get_session(telegram)["end_reason"] is None
+
+        parent = "20260925_failed"
+        _seed(db, parent)
+        monkeypatch.setattr(db, "publish_compression_child", lambda **_: (_ for _ in ()).throw(RuntimeError("disk full")))
+        response = _call({"session_id": parent})
+        assert response["error"]["code"] == 5006
+        assert db.get_session(parent)["end_reason"] is None
+    finally:
+        db.close()
