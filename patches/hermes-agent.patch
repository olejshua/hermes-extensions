diff --git a/agent/plugin_session_policy.py b/agent/plugin_session_policy.py
new file mode 100644
index 0000000..5402478
--- /dev/null
+++ b/agent/plugin_session_policy.py
@@ -0,0 +1,245 @@
+"""Operator-granted context policy and typed post-persistence continuation.
+
+No provider, queue, message transport or monkeypatch. Required policy failures stop
+the request; an uninstalled policy must never silently re-enable compaction.
+"""
+from dataclasses import dataclass
+import os
+
+
+class SessionPolicyBlocked(RuntimeError):
+    pass
+
+
+@dataclass(frozen=True)
+class ContextDirective:
+    context: str = ""
+    block: bool = False
+    reason: str = "session_policy_blocked"
+    disable_compaction: bool = False
+    silent_transition: bool = False
+
+
+@dataclass(frozen=True)
+class Continuation:
+    session_id: str
+    history: list
+    prompt: str
+    turn_author: dict = None
+    source_platform_message_id: str = None
+
+
+def register(ctx, callback):
+    if ctx.get_config('session_policy_enabled', False) is not True or not callable(callback):
+        raise PermissionError('explicit_session_policy_grant_required')
+    manager = ctx._manager
+    if not hasattr(manager, '_session_policies'):
+        manager._session_policies = {}
+    if ctx.plugin_id in manager._session_policies:
+        raise ValueError('duplicate_session_policy')
+    return ctx._track_mapping_entry('session_policy', ctx.plugin_id,
+                                    manager._session_policies, callback)
+
+
+def required():
+    return os.environ.get('HERMES_REQUIRED_SESSION_POLICY', '').strip()
+
+
+def resolve(agent, phase, *, messages=None, approx_tokens=None, tool_calls=None):
+    from hermes_cli.plugins import _delivery_manager
+    manager = _delivery_manager()
+    entries = getattr(manager, '_session_policies', {})
+    required_id = required()
+    if required_id and required_id not in entries:
+        raise SessionPolicyBlocked('required_session_policy_missing')
+    contexts = []
+    for plugin_id, callback in list(entries.items()):
+        plugin = manager._plugins.get(plugin_id)
+        if plugin is None or not plugin.enabled:
+            raise SessionPolicyBlocked('session_policy_unavailable')
+        try:
+            result = manager._run_hook_callback_bounded('session_context_policy', callback,
+                dict(agent=agent, phase=phase, messages=messages, approx_tokens=approx_tokens,
+                     tool_calls=tool_calls), 0.25)
+        except (Exception, SystemExit):
+            raise SessionPolicyBlocked('session_policy_failed') from None
+        if type(result) is not ContextDirective:
+            raise SessionPolicyBlocked('session_policy_invalid_or_timeout')
+        if result.block:
+            raise SessionPolicyBlocked(result.reason)
+        if result.disable_compaction:
+            # Per-agent native switches; existing child/worker configuration stays
+            # untouched. Avoid even preflight feasibility probes for a vetoed root.
+            agent.compression_enabled = False
+            agent.codex_responses_native_compaction = False
+        if result.silent_transition:
+            enter_silence(agent)
+        if result.context:
+            contexts.append(result.context)
+    return '\n\n'.join(contexts)
+
+
+def before_request(agent, state):
+    """Runs before request rendering, once per iteration, so advice reaches the model."""
+    if vars(agent).pop('_session_unsilence_after_ack', False):
+        end_silence(agent)
+    if getattr(agent, '_session_transition_silent', False):
+        enter_silence(agent)  # newly bound per-turn callbacks, same native agent
+    from agent.model_metadata import estimate_messages_tokens_rough, estimate_tokens_rough
+    estimate = estimate_messages_tokens_rough(state.messages)
+    estimate += estimate_tokens_rough(state.active_system_prompt or '')
+    # Real last-request input is another anchor; unknown does not become zero.
+    prior = getattr(state, 'approx_tokens', None)
+    if isinstance(prior, int) and not isinstance(prior, bool):
+        estimate = max(estimate, prior)
+    context = resolve(agent, 'request', messages=state.messages, approx_tokens=estimate)
+    if context:
+        from agent.turn_context import append_message
+        append_message(state.messages, {'role': 'user', 'content': context, 'display_kind': 'hidden'})
+
+
+_PRESENTATION_CALLBACKS = ('_stream_callback', 'stream_delta_callback',
+    'interim_assistant_callback', 'status_callback', 'notice_callback',
+    'notice_clear_callback', 'tool_progress_callback', 'tool_start_callback',
+    'tool_complete_callback', 'tool_gen_callback', 'step_callback',
+    'thinking_callback', 'reasoning_callback', 'event_callback')
+
+
+def enter_silence(agent):
+    if not getattr(agent, '_session_transition_silent', False):
+        agent._session_transition_streaming_before = getattr(agent, '_disable_streaming', False)
+    agent._session_transition_silent = True
+    agent._disable_streaming = True
+    for name in _PRESENTATION_CALLBACKS:
+        callback = getattr(agent, name, None)
+        if not callable(callback) or getattr(callback, '_session_visibility_owner', None) is agent:
+            continue
+        def guarded(*args, _callback=callback, **kwargs):
+            if not getattr(agent, '_session_transition_silent', False):
+                return _callback(*args, **kwargs)
+            return None
+        guarded._session_visibility_owner = agent
+        setattr(agent, name, guarded)
+
+
+def end_silence(agent):
+    if getattr(agent, '_session_transition_silent', False):
+        agent._disable_streaming = vars(agent).pop('_session_transition_streaming_before', False)
+    agent._session_transition_silent = False
+
+
+def settle_visibility(agent, result):
+    terminal_silence = vars(agent).pop('_silent_tool_handoff', False)
+    quiet_error = (getattr(agent, '_session_transition_silent', False) and
+                   (result.get('failed') or result.get('error')) and not result.get('user_action_required'))
+    silent = bool(terminal_silence or result.get('session_handoff_silent') or quiet_error)
+    if silent:
+        result['session_handoff_silent'] = True
+        result['final_response'] = ''
+        result['response_previewed'] = False
+        if terminal_silence:
+            result['failed'] = False
+            result['completed'] = True
+            result.pop('error',None)
+    elif getattr(agent, '_session_transition_silent', False):
+        # A normal task answer without a rollover still uses normal final delivery.
+        result['response_previewed'] = False
+    end_silence(agent)
+    return result
+
+
+def blocked_result(agent, reason, messages=None, *, needs_user_action=False):
+    return dict(final_response=('Für die Fortsetzung ist ein Dauerauftrag noch an die bisherige Session gebunden. '
+                'Wie soll ich mit diesem Auftrag umgehen?' if needs_user_action else ''),
+                messages=messages or getattr(agent, '_session_messages', []) or [],
+                session_id=agent.session_id, api_calls=0, failed=not needs_user_action,
+                error=None if needs_user_action else 'session_policy_blocked', context_rollover_blocked=True,
+                session_policy_block_reason=reason, user_action_required=needs_user_action,
+                session_handoff_silent=not needs_user_action)
+
+
+def continue_pending(agent, result, run_turn, *, task_id=None, stream_callback=None):
+    pending = vars(agent).pop('_pending_session_handoff', None)
+    if pending is None:
+        return result
+    used = int(result.get('api_calls') or 0)
+    original_limit = agent.max_iterations
+    remaining = original_limit - used
+    if remaining < 2:
+        blocked = blocked_result(agent, 'insufficient_iteration_reserve_for_checkin', result.get('messages'))
+        blocked['api_calls'] = used
+        return blocked
+    def new_input_pending():
+        from contextlib import nullcontext
+        with getattr(agent,'_pending_steer_lock',None) or nullcontext():
+            return bool(getattr(agent,'_pending_steer',None) or getattr(agent,'_interrupt_requested',False))
+    if new_input_pending():
+        blocked=blocked_result(agent,'new_input_during_native_handoff',result.get('messages'))
+        blocked['api_calls']=used
+        return blocked
+    # Exactly one publication attempt per source. The registered callback owns its
+    # durable claim and verification; no retry on an uncertain outcome.
+    # This is the same authorised human task, not a new unbound internal author.
+    # Capture only host-owned provenance before reset; never infer it from text.
+    original_author = getattr(agent, '_turn_author', None)
+    original_author = dict(original_author) if isinstance(original_author, dict) else None
+    original_platform_id = getattr(agent, '_persist_user_message_platform_id', None)
+    from gateway.session_context import get_session_env
+    original_source = (get_session_env('HERMES_SESSION_KEY'), get_session_env('HERMES_SESSION_MESSAGE_ID'))
+    try:
+        continuation = pending.prepare(agent, result)
+        if (type(continuation) is not Continuation or not continuation.history or
+                agent.session_id != continuation.session_id or not continuation.prompt):
+            raise SessionPolicyBlocked('invalid_session_continuation')
+        if new_input_pending():raise SessionPolicyBlocked('new_input_during_native_handoff')
+        if original_source != (get_session_env('HERMES_SESSION_KEY'), get_session_env('HERMES_SESSION_MESSAGE_ID')):
+            raise SessionPolicyBlocked('new_input_during_native_handoff')
+    except (Exception, SystemExit) as exc:
+        needs_user = str(exc) == 'active_goal_requires_explicit_migration'
+        blocked = blocked_result(agent, 'handoff_publication_or_verification_failed', needs_user_action=needs_user)
+        known = {'prepared_checkout_required','active_goal_requires_explicit_migration',
+            'active_children_block_rollover','detached_subagent_blocks_rollover','active_process_blocks_rollover',
+            'active_background_job_blocks_rollover','source_row_identity_missing',
+            'new_source_material_requires_fresh_checkout','native_child_readback_failed',
+            'native_loader_would_change_handoff','handoff_exceeds_fresh_session_reserve',
+            'checkout_source_watermark_missing','handoff_hash_changed','handoff_parent_watermark_changed',
+            'background_session_binding_unknown','invalid_session_continuation'}
+        blocked['session_policy_detail'] = str(exc) if str(exc) in known else type(exc).__name__
+        blocked['api_calls'] = int(result.get('api_calls') or 0)
+        return blocked
+    try:
+        agent.max_iterations = remaining
+        continued_author = continuation.turn_author if continuation.turn_author is not None else original_author
+        continued_platform_id = (continuation.source_platform_message_id
+            if continuation.source_platform_message_id is not None else original_platform_id)
+        if (continued_platform_id is not None and get_session_env('HERMES_SESSION_MESSAGE_ID')
+                and str(continued_platform_id) != str(get_session_env('HERMES_SESSION_MESSAGE_ID'))):
+            raise SessionPolicyBlocked('new_input_during_native_handoff')
+        result = run_turn(agent, continuation.prompt,
+            conversation_history=continuation.history, task_id=task_id,
+            stream_callback=stream_callback, persist_user_display_kind='hidden',
+            turn_author=continued_author, persist_user_platform_id=continued_platform_id)
+        from agent.turn_context import export_current_turn_boundary
+        result = export_current_turn_boundary(agent, result, continuation.prompt)
+    except SessionPolicyBlocked as exc:
+        result = blocked_result(agent, str(exc), continuation.history)
+    except (Exception, SystemExit) as exc:
+        # An unexpected technical checkin failure must not escape into a transport's
+        # generic user-visible exception handler. Preserve only a safe internal tag.
+        result = blocked_result(agent, 'child_checkin_runtime_failed', continuation.history)
+        result['session_policy_detail'] = type(exc).__name__
+    finally:
+        agent.max_iterations = original_limit
+    result['api_calls'] = used + int(result.get('api_calls') or 0)
+    try:
+        verified = callable(pending.verify) and pending.verify(agent, result)
+    except (Exception, SystemExit):
+        verified = False
+    if not verified:
+        blocked = blocked_result(agent, 'child_checkin_not_confirmed', result.get('messages'))
+        blocked['api_calls'] = result['api_calls']
+        return blocked
+    # No recursion: another requested rollover stays a visible, resumable blocker.
+    if vars(agent).pop('_pending_session_handoff', None) is not None:
+        return blocked_result(agent, 'second_rollover_requires_next_turn', result.get('messages'))
+    return result
diff --git a/agent/plugin_turn_handoff.py b/agent/plugin_turn_handoff.py
new file mode 100644
index 0000000..5f16143
--- /dev/null
+++ b/agent/plugin_turn_handoff.py
@@ -0,0 +1,75 @@
+"""Typed, operator-granted post-persistence tool handoff; tool text grants nothing."""
+from __future__ import annotations
+from dataclasses import dataclass
+from types import SimpleNamespace
+
+@dataclass(frozen=True)
+class TurnHandoff:
+    response: str
+    tool_name: str
+
+@dataclass(frozen=True)
+class SilentTurnHandoff(TurnHandoff):
+    pass
+
+@dataclass(frozen=True)
+class SessionHandoff(TurnHandoff):
+    prepare: object
+    verify: object = None
