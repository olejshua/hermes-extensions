+    return TurnOrigin(sid,session,agent,user,request=request,binding=binding)
+
+def accept_at_claim(frame):
+    # Called under the actual native _sessions_lock immediately before the
+    # existing _start_session_work. Preparation/scheduling is not acceptance.
+    from tui_gateway import server
+    if frame is None:return True
+    if type(frame) is not TurnOrigin:return False
