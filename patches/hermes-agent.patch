+"""Content-free external job status in the owning gateway turn, without model calls."""
+import contextvars, threading, time
+from contextlib import contextmanager
+CURRENT=contextvars.ContextVar('external_progress',default=None)
+LABELS={'running':'läuft','tool.started':'bearbeitet Dateien','tool.completed':'Dateischritt fertig','provider.completed':'Modellschritt fertig','completed':'fertig','failed':'fehlgeschlagen','cancelled':'abgebrochen'}
+class TurnSink:
+    def __init__(self,session,emit,valid):
+        self.session=session;self.emit=emit;self.valid=valid;self.closed=False;self.lock=threading.RLock();self.jobs={}
+    def close(self):
+        with self.lock:self.closed=True
+    def bind(self,turn):
+        def progress(job,event):
+            kind={'native.started':'running','native.tool.started':'tool.started','native.tool.completed':'tool.completed','native.provider_call':'provider.completed'}.get(event,event.removeprefix('job.'));label=LABELS.get(kind)
+            if label is None:return False
+            with self.lock:
+                if self.closed or not self.valid(turn):return False
+                now=time.monotonic();last,final=self.jobs.get(job,(-1e9,False));done=kind in ('completed','failed','cancelled')
+                if final or (not done and now-last<15):return False
+                self.jobs[job]=(now,done)
+                try:self.emit('🛠 Coding '+str(job)[:8]+': '+label)
+                except Exception:return False
+                return True
+        return progress
+@contextmanager
+def bind_agent_progress(agent):
+    sink=getattr(agent,'external_progress_sink',None)
+    token=CURRENT.set(sink.bind(str(getattr(agent,'_current_turn_id',''))) if sink else None)
+    try:yield
+    finally:CURRENT.reset(token)
+def capture():return CURRENT.get()
