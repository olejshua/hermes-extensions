+        handler.store.settled(row['job_id'],'final',success=delivered)
+        return 'delivered' if delivered else 'unknown'
+    except BaseException:
+        handler.store.settled(row['job_id'],'final',success=False)
+        raise
+
+
+def _receipt(messages):
+    from agent.context_compressor import _DB_PERSISTED_MARKER
+    ids=[m.get('_row_id') for m in messages]
+    if (not messages or not all(m.get(_DB_PERSISTED_MARKER) is True and type(i) is int and i>0
+                                for m,i in zip(messages,ids))):
+        raise RuntimeError('native_dialogue_persistence_unconfirmed')
+    return {'row_ids':ids,'final_assistant_row_id':ids[-1],'complete':True}
+
+
+def persist_notice(agent, record, text):
+    history=list(record.get('history') or [])
+    message={'role':'assistant','content':text}
+    messages=history+[message]
+    # Stale per-turn user override must not rewrite an out-of-band assistant row.
+    agent._ensure_db_session()
+    agent._persist_session(messages,conversation_history=history)
+    receipt=_receipt([message])
+    record['history']=messages
+    record['history_version']=int(record.get('history_version',0))+1
+    return receipt
+
+
+def control_result(agent, reply, prompt, history):
+    if type(reply) is not ControlReply or reply.frame.agent is not agent or not reply.frame.owns_turn():
+        raise ValueError('native_desktop_control_reply_required')
+    # Use the actual append-only native persistence, preserving staged submit-row
+    # adoption; no provider/finalizer/micro-compaction/auxiliary call is started.
+    pending=getattr(agent,'_pending_cli_user_message',None)
+    user=(pending if isinstance(pending,dict) and pending.get('role')=='user'
+          and pending.get('content')==prompt else {'role':'user','content':prompt})
+    agent._pending_cli_user_message=None
+    assistant={'role':'assistant','content':reply.text}
+    messages=list(history)+[user,assistant]
+    agent._persist_user_message_idx=len(history)
+    agent._persist_user_message_override=prompt
+    agent._persist_user_message_timestamp=user.get('timestamp')
+    agent._persist_user_message_platform_id=user.get('platform_message_id')
+    agent._ensure_db_session()
+    agent._persist_session(messages,conversation_history=history)
+    _receipt([user,assistant])
+    from hermes_cli.plugins import invoke_hook
+    invoke_hook('on_session_end',session_id=agent.session_id,task_id=reply.frame.session_key,
+                turn_id=uuid.uuid4().hex,completed=True,failed=False,interrupted=False,
+                turn_exit_reason='native_desktop_control',model=getattr(agent,'model',''),platform='tui')
+    return {'messages':messages,'final_response':reply.text,'completed':True,'interrupted':False,
+            'failed':False,'api_calls':0,'turn_exit_reason':'native_desktop_control'}
