+def _auto_rotation_handoff(db, parent_id: str) -> dict:
+    """Keep a small real context snapshot with the durable native lineage pointer."""
+    excerpts, budget = [], 6000
+    try:
+        rows = db.get_messages_as_conversation(parent_id, include_row_ids=False)
+    except Exception:
+        rows = []
+    for row in reversed(rows):
