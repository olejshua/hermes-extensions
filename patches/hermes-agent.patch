+                        or home_of(record) != current_binding.profile_home
+                        or record.get('active_session_lease') is not lease or getattr(lease,'released',False)
+                        or int(record.get('_queued_prompt_generation',0)) != generation
+                        or record.get('running') or record.get('queued_prompt') or record.get('queued_prompts')
+                        or record.get('_closing') or record.get('lazy') or compute_host
+                        or len(peers)!=1 or peers[0] is not peer
+                        or not login_matches(getattr(peer,'_hermes_native_login',None),current_binding)):
+                    raise ValueError('native_desktop_transport_changed')
