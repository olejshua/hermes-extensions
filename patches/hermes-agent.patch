+"""Cold-resume automatic Desktop/TUI idle rotation."""
+
+from __future__ import annotations
+
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+def _seed(db: SessionDB, sid: str, *, source: str = "desktop", title: str | None = None) -> None:
+    db.create_session(sid, source=source, model="test-model")
+    if title:
+        assert db.set_session_title(sid, title)
+    db.append_message(sid, "user", "Need a durable continuation.")
+    db.append_message(sid, "assistant", "The current session has enough context to continue.")
+    db.set_compression_ineffective_count(sid, 2)
+
+
+def _resume(sid: str) -> dict:
+    return server.handle_request({"id": "resume", "method": "session.resume", "params": {
+        "session_id": sid, "source": "desktop",
+    }})
+
+
+def _clean_sessions(original: dict) -> None:
+    server._sessions.clear()
+    server._sessions.update(original)
+
+
+def test_cold_resume_auto_rotation_is_opt_in(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    original = dict(server._sessions)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda _sid: None)
+    monkeypatch.delenv("HERMES_SESSION_AUTO_ROTATE", raising=False)
+    try:
+        _seed(db, "auto-optout")
+        response = _resume("auto-optout")
+        assert response["result"]["resumed"] == "auto-optout"
+        assert db.get_session("auto-optout")["end_reason"] is None
+        assert db.get_compression_tip("auto-optout") == "auto-optout"
+    finally:
+        _clean_sessions(original)
+        db.close()
+
+
+def test_cold_resume_rotates_and_returns_child_stored_id(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    original = dict(server._sessions)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda _sid: None)
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    try:
+        _seed(db, "auto-success")
+        response = _resume("auto-success")
+        result = response["result"]
+        child = result["resumed"]
+        assert child != "auto-success"
+        assert result["session_key"] == child
+        assert db.get_session("auto-success")["end_reason"] == "compression"
+        assert db.get_session(child)["parent_session_id"] == "auto-success"
+        # Re-resuming the original id resolves to the durable tip, not a second child.
+        _clean_sessions(original)
+        again = _resume("auto-success")["result"]
+        assert again["resumed"] == child
+        assert db.get_compression_chain("auto-success") == ["auto-success", child]
+    finally:
+        _clean_sessions(original)
+        db.close()
+
+
+def test_cold_resume_auto_rotation_refuses_pinned_and_bot_chat(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    original = dict(server._sessions)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda _sid: None)
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    try:
+        _seed(db, "auto-pinned")
+        assert db.set_session_pinned("auto-pinned", True)
+        pinned = _resume("auto-pinned")["result"]
+        assert pinned["resumed"] == "auto-pinned"
+        assert db.get_session("auto-pinned")["end_reason"] is None
+        _clean_sessions(original)
+
+        _seed(db, "auto-bot", title="Bot Chat")
+        bot = _resume("auto-bot")["result"]
+        assert bot["resumed"] == "auto-bot"
+        assert db.get_session("auto-bot")["end_reason"] is None
+    finally:
+        _clean_sessions(original)
+        db.close()
+
+
+def test_cold_resume_failure_keeps_parent_but_follows_durable_child(monkeypatch, tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    original = dict(server._sessions)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda _sid: None)
+    monkeypatch.setenv("HERMES_SESSION_AUTO_ROTATE", "1")
+    try:
+        _seed(db, "auto-fail")
+        monkeypatch.setattr(db, "publish_compression_child", lambda **_: (_ for _ in ()).throw(RuntimeError("disk full")))
+        failed = _resume("auto-fail")["result"]
+        assert failed["resumed"] == "auto-fail"
+        assert db.get_session("auto-fail")["end_reason"] is None
+        _clean_sessions(original)
+
+        _seed(db, "auto-recover")
+        publish = SessionDB.publish_compression_child.__get__(db, SessionDB)
+
+        def publish_then_raise(**kwargs):
+            publish(**kwargs)
+            raise RuntimeError("caller lost commit acknowledgement")
+
+        monkeypatch.setattr(db, "publish_compression_child", publish_then_raise)
+        recovered = _resume("auto-recover")["result"]
+        child = recovered["resumed"]
+        assert child != "auto-recover"
+        assert db.get_session(child)["parent_session_id"] == "auto-recover"
+    finally:
+        _clean_sessions(original)
+        db.close()
